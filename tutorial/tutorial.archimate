        <child xsi:type="archimate:DiagramObject" id="id-9f26348fe2f94be7b2ce20e3d400cfc4" targetConnections="id-f4341e8da6684979a841a5422d17fcf2" font="1|Comfortaa|11.0|0|GTK|1|" lineColor="#1a5fb4" fillColor="#62a0ea" alpha="96" textPosition="1" archimateElement="id-a7c1d2ab54624442b7a8bbd9818444ba">
