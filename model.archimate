            <bounds x="109" y="144" width="291" height="35"/>
          </child>
          <child xsi:type="archimate:Group" id="id-5426bac817544b4783bd90124cd2f396" name="Section" font="1|Noto Sans|9.0|0|GTK|1|" textAlignment="1">
            <bounds y="192" width="400" height="85"/>
            <feature name="labelExpression" value="Value Streams"/>
            <feature name="lineAlpha" value="64"/>
            <child xsi:type="archimate:DiagramModelReference" id="id-e6cb564e57c54ca6aaadef27673f9cfe" targetConnections="id-4fd3c1ab7ba046689c257ed1758c03f7" model="id-880ac917a3a24c42ae40ceb269ad1882">
              <bounds x="109" y="36" width="291" height="35"/>
            </child>
            <child xsi:type="archimate:DiagramModelReference" id="id-ef18002b28c04839959f50eae565b79d" targetConnections="id-0f31206775ca4d668a05ee6f232fad8b" model="id-1acc7ae30dac42faa09dc5bc0f0443c6">
