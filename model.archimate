          <child xsi:type="archimate:DiagramModelReference" id="id-63eb6d4814e64e19a5fb424ac3d6c3cb" model="id-1acc7ae30dac42faa09dc5bc0f0443c6">
            <bounds x="144" y="156" width="253" height="25"/>
