        <child xsi:type="archimate:Note" id="id-0143673b22b0403298ef7f095f591e62" font="1|Noto Sans|9.0|0|GTK|1|" textAlignment="1" fillColor="#f6f5f4" alpha="64" borderType="1">
          <bounds x="24" y="240" width="284" height="49"/>
          <feature name="lineStyle" value="3"/>
          <sourceConnection id="id-0f31206775ca4d668a05ee6f232fad8b" lineWidth="2" lineColor="#1a5fb4" source="id-0143673b22b0403298ef7f095f591e62" target="id-ef18002b28c04839959f50eae565b79d" type="1"/>
        </child>
        <child xsi:type="archimate:Note" id="id-3b6a69734c694d608d40cdde45578baa" font="1|Noto Sans|9.0|0|GTK|1|" textAlignment="1" alpha="0" borderType="1">
          <bounds x="36" y="252" width="265" height="25"/>
          <feature name="lineStyle" value="3"/>
          <content>Step 3. Link the Template</content>
        </child>
        <child xsi:type="archimate:Note" id="id-48f0b653d4db470e868472760f276736" font="1|Noto Sans|9.0|0|GTK|1|" textAlignment="1" fillColor="#f6f5f4" alpha="64" borderType="1">
          <bounds x="24" y="300" width="284" height="49"/>
