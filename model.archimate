      <folder name="CSS" id="id-8efcd04d9cd04bcb822b927aca083b0f">
        <element xsi:type="archimate:ArchimateDiagramModel" name="CSS:blockquote+lead" id="id-67cb1b274a1040818694b44a2403698b">
          <child xsi:type="archimate:Group" id="id-e2918652cc4848219b6c41b34c8de904" name="CSS" textAlignment="1">
            <bounds x="24" y="24" width="400" height="61"/>
            <documentation>blockquote, .lead
 {
    margin: 1cm 0 1.5cm 0;
    padding: 0.3em 1.5em;

    background-color: #21447809;
    border-radius: 4mm;

    color: #214478;
    font-size: 11pt;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: 0.01em;
}</documentation>
          </child>
        </element>
        <element xsi:type="archimate:ArchimateDiagramModel" name="CSS:headers" id="id-071a4154d6f84cebb97530704dca9eb2">
          <child xsi:type="archimate:Group" id="id-978b9aa3e2ee4a4bb025664d60bb1939" name="CSS" textAlignment="1">
            <bounds x="24" y="24" width="400" height="140"/>
            <documentation>h1,h2,h3,h4,h5 {
	color: #214478;
}

h1 {
	break-before: page;
    font-size: 11pt;
    font-family: 'Comfortaa-Bold';
    string-set: heading content();
	counter-increment: h1-counter;
	counter-reset: h2-counter;
	text-transform: uppercase;
	font-weight: normal;
	position: relative; 
	padding-left: 1cm;
	margin-top: 50px;
}

h1::before {
 	content: counter(h1-counter);
	font-weight: normal;
	position: absolute;
	left: 0;
}

h2 {
    font-family: 'Comfortaa-Bold';
    font-size: 11pt;
	font-weight: normal;
	counter-increment: h2-counter;
	counter-reset: h3-counter;
	position: relative; 
	padding-left: 1cm;
}
 
h2::before {
 	content: counter(h1-counter) &quot;.&quot; counter(h2-counter) &quot; &quot;;
    font-size: 11pt;
	font-weight: normal;
	position: absolute;
	left: 0;
}

h3 {
	font-family: 'Segoe UI';
    font-size: 11pt;
	font-weight: normal;
	counter-increment: h3-counter;
	position: relative; 
	padding-left: 1cm;
}
 
h3::before {
 	content: counter(h1-counter) &quot;.&quot; counter(h2-counter) &quot;.&quot; counter(h3-counter) &quot; &quot;;
    font-size: 11pt;
	font-weight: normal;
	position: absolute;
	left: 0;
}
</documentation>
          </child>
        </element>
        <element xsi:type="archimate:ArchimateDiagramModel" name="CSS:html" id="id-b5c7f7fe77a14cbe9ddaad7af75b11eb">
          <child xsi:type="archimate:Group" id="id-ac9b0738755140dc90a6850e5aec1b4e" name="CSS" textAlignment="1">
            <bounds x="12" y="36" width="400" height="85"/>
            <documentation>html {
    color: #000000;
    font-family: &quot;Comfortaa&quot;, sans-serif;
    font-size: 9pt;
    font-weight: 300;
    line-height: 1.5;
	counter-reset: h1-counter h2-counter view-counter;
}

figure.diagram-figure {
    display: flex;
    flex-direction: column !important;
    align-items: center;
    page-break-inside: avoid;
}

figure.diagram-figure .diagram-caption {
    align-self: flex-end !important;
    text-align: right !important;
    justify-content: flex-end;
}

.diagram-figure img {
  max-width: 100%;
  height: auto; 
  display: block; 
  margin: 0 auto;
  margin-top: 0.8em;
}

.diagram-caption {
  align-self: flex-end;
  text-align: right;
  counter-increment: view-counter;
  color: #214478;
  display: block; 
  margin-top: 0.8em; 
  font-size: 0.9em; 
  padding: 0 1em; 
}


.diagram-caption::before {
  content: &quot;Diagram &quot; counter(view-counter)  &quot;:&quot;;
  margin-right: 0.1em;
}
</documentation>
          </child>
        </element>
        <element xsi:type="archimate:ArchimateDiagramModel" name="CSS:page" id="id-67856c48006d4710b96faa8f2c636405">
          <child xsi:type="archimate:Group" id="id-de8b8fe3f7884e41a20ab6e18c658111" name="CSS" textAlignment="1">
            <bounds x="104" y="81" width="400" height="140"/>
            <documentation>@page portrait { 
	size: A4; 
}
@page landscape { 
	size: A4 landscape; 
}


@page {
	size: A4;
	@bottom-left {
		color: #214478;
		content: counter(page) &quot; of &quot; counter(pages) &quot; ArchiFabric&quot;;
		position: absolute;
		z-index: -1;
	}
}</documentation>
          </child>
        </element>
      </folder>
