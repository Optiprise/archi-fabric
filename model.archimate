    <folder name="core" id="id-6bc307d9fbaf4efda3cd3cf3647240ff"/>
    <element xsi:type="archimate:ApplicationFunction" name="renderStructure(modelStructure, targetStructure) " id="id-be1f76f5548443d5a8acc99e28aaac63"/>
    <element xsi:type="archimate:ApplicationFunction" name="&lt;&lt;ModelStructure>>" id="id-2834f72379054f80a541811c3564154a"/>
    <element xsi:type="archimate:ApplicationComponent" name="&lt;&lt;artifact>>" id="id-0c499f220950413d93868c2839ede659"/>
