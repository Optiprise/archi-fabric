          <child xsi:type="archimate:Group" id="id-15581471d83240d9919ca9fe3f04cfae" name="Section" font="1|Noto Sans|9.0|0|GTK|1|" fontColor="#77767b" textAlignment="1" alpha="64">
            <bounds y="60" width="400" height="49"/>
            <feature name="labelExpression" value="Hello World!"/>
            <feature name="lineAlpha" value="64"/>
            <documentation>**Welcome** to our first ArchiFabric document. This section demonstrates how a _Label Expression_ creates a header, while this text is placed directly beneath it.</documentation>
          </child>
          <child xsi:type="archimate:DiagramModelReference" id="id-e0a11d043a9d49ae8a9f655afb8e98e2" fontColor="#77767b" model="id-60b077d687d74c32ab234026fe5d1347">
            <bounds y="144" width="110" height="35"/>
          </child>
