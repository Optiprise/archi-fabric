        <child xsi:type="archimate:DiagramObject" id="id-f2e5cbd6dd334a768938a6a62f974b43" targetConnections="id-2a9cb08105194d5bb2327cbd25590fe5 id-df27f5e221944933adf2c89673d09af0 id-cf9252bc62de479ebc4767986ebcfc75 id-3e79fccc0b7b4d09b23d3e9f72eb3454" font="1|Comfortaa|11.0|0|GTK|1|" lineColor="#5e5c64" fillColor="#77767b" alpha="96" textPosition="1" archimateElement="id-1de10986886645bdbc757fd98384a643">
