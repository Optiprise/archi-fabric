            <bounds x="144" y="60" width="253" height="25"/>
          </child>
          <child xsi:type="archimate:DiagramModelReference" id="id-46e0a2bd8bfe4f73be0799a614229b79" model="id-60b077d687d74c32ab234026fe5d1347">
