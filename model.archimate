            <child xsi:type="archimate:Group" id="id-6648efea453a4c93a1d20fa030989e35" name="CSS" textAlignment="1">
              <bounds y="36" width="565" height="49"/>
              <documentation>@page :first {
  margin: 0; 
  margin-top: 2cm;  
  @bottom-left {
    content: none;
  }
}

.documenttitle {
    margin-top: 2cm;  
    font-size: 36pt;
    break-after: page; 
}

figcaption.logo-caption {
    display: none;
}

.align-left {
    text-align: left;
    display: flex;
    justify-content: flex-start;
}

.align-center {
    text-align: center;
    display: flex;
    justify-content: center;
}

.align-right {
    text-align: right;
    display: flex;
    justify-content: flex-end;
}

.diagram img {
    max-width: 100%;
    height: auto;
}</documentation>
            </child>
          </child>
        </element>
      </folder>
      <folder name="TOC" id="id-339c37cb8b974b93a09267fd78d30021">
        <element xsi:type="archimate:ArchimateDiagramModel" name="Table of Content" id="id-28ea29e557294e0ca3aa6c689f5ebdf7">
          <child xsi:type="archimate:Group" id="id-f8a58a4d3eea4011b0b9440b4b56ee37" name="TOC class=new-page" textAlignment="1">
            <bounds x="12" y="24" width="565" height="193"/>
            <feature name="labelExpression" value="Table of Content"/>
            <documentation>section.toc {
    break-before: page;
}

ul.toc {
    list-style-type: none;
    padding: 0;
    margin: 1em 0;
    display: block;
}

li.toc {
    display: block;
}

/* Base link styling */
li.toc a {
    text-decoration: none;
    color: #000000;
}

li.toc a::after {
    content: leader('.') ' ' target-counter(attr(href), page);
}

/* Opmaken en inspringen per niveau */
li.toc.h1 { 
    margin-top: 10px; /* Extra witregel boven een nieuw H1 hoofdstuk */
}
li.toc.h1 a {
    color: #214478;
    font-family: 'SegoeUI-Semibold';
    font-size: 11pt;
    font-variant: all-small-caps;
}

li.toc.h2 { padding-left: 15px; } /* Inspringing voor h2 */
li.toc.h2 a {
    color: #000000;
    font-family: 'SegoeUI';
    font-size: 9pt;
    font-style: italic;
    font-variant: normal;
}

li.toc.h3 { padding-left: 30px; } /* Verder inspringen voor h3 */
li.toc.h4 { padding-left: 45px; } /* Verder inspringen voor h4 */</documentation>
          </child>
        </element>
      </folder>
