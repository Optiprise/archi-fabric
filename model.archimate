          <child xsi:type="archimate:DiagramObject" id="id-9ef3c613ee1e44e2b8b34204c6d3519d" targetConnections="id-184990e5699149f4adc511f4c5bdbf07 id-9d81ae6f4a8c4264a202e4e62e57e829" font="1|Segoe UI Emoji|9.0|0|GTK|1|" fontColor="#000000" lineColor="#5c5c5c" textAlignment="1" fillColor="#214378" alpha="64" textPosition="1" archimateElement="id-7309b4d8640448328387d4d1b2d2fe0d">
