        <element xsi:type="archimate:ArchimateDiagramModel" name="Second Page" id="id-64d0c3e5c45f4b1f857b7fb86f6bdcfa">
          <child xsi:type="archimate:Group" id="id-9b2d9873a70c45838daecd1867992129" name="Section class=second_page" textAlignment="1">
            <bounds x="12" y="12" width="565" height="409"/>
            <child xsi:type="archimate:Group" id="id-ee67891092dd415eaab6c4f7fecfedd2" name="CSS" textAlignment="1">
              <bounds y="24" width="565" height="37"/>
              <documentation>section.second_page {
    break-before: page;

    display: flex;
    flex-direction: column;

    min-height: 257mm;      /* A4 minus marges */
    box-sizing: border-box;
}

section.second_page .properties {
    margin-top: 2cm;
    font-size: 6.5pt;
}

section.second_page .disclaimer {
    margin-top: 10cm;       /* Duwt de disclaimer naar de onderkant */
    color: #214478;
    font-size: 5.5pt;
}
</documentation>
