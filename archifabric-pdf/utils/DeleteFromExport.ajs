// Delete all folders, elements and views with property _delete_from_export_ = true
console.log("Delete all folders, elements and views with property _delete_from_export_ = true");
$("folder").each(function(folder) {
    if (folder.prop("_delete_from_export_") == "true") {
        folder.delete(); 
    }
    else {
        $(folder).children("element").each(function(element) {
            if (element.prop("_delete_from_export_") == "true") {
                element.delete(); 
            }
        }); 
        $(folder).children("view").each(function(view) {
            if (view.prop("_delete_from_export_") == "true") {
                view.delete();
            }
        }); 
    }
});