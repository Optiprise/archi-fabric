const prefs = Java.type(
    'com.archimatetool.script.ArchiScriptPlugin'
).getInstance().getPreferenceStore();

console.log("CommonJS module system is currently enabled: " + prefs.getBoolean('commonJSEnabled'));
prefs.setValue('commonJSEnabled', false);
